# Testnet only. Copy this file to `.env` and fill it in. `.env` holds secret
# keys and it never enters the repository. Set `ENV_FILE` when the working
# directory is not the one that holds the file.
#
# To create and fund every account below, run this from the repository root:
#
#   npm run --silent new-keys --workspace @senet/server > .env
#   chmod 600 .env
#
# The tool asks friendbot to fund each account. It then waits until Horizon
# reports a balance, so an account that it prints is an account that works. It
# writes no file, and it can therefore never lose a key that a `.env` already
# holds. `CHANNEL_COUNT` sets the number of channel accounts, and the default
# is six.

# The channel accounts that pay the network fee, as secret keys separated by
# commas. One channel serves one transaction per ledger, so the count sets the
# throughput. Each channel holds 1 XLM of base reserve and about 47,743 stroops
# for one transaction in flight. Two channels must never share a key. A run
# that redeems several vouchers at once needs at least that many channels.
FEEPAYER_CHANNELS=

# Signs every voucher. The address derives from the secret, so this file never
# carries both. A copy of a derived value can disagree with its own source.
PAYER_SECRET=

# Submits the evidence transactions and pays their fee.
SUBMITTER_SECRET=

# Receives a redemption. A merchant signs nothing, so this file keeps the
# address and no secret. A secret for an account that never signs is a
# liability with no purpose.
MERCHANT_ADDRESS=

# Receives a refused attempt.
SECOND_MERCHANT_ADDRESS=

# Signs the SEP-7 payment requests that this domain produces. A wallet reads
# `origin_domain` from a request, fetches that domain's Stellar information
# file, takes `URI_REQUEST_SIGNING_KEY` and checks the signature against it.
# The key must therefore stay the one that the published file names, because a
# new key means a new published file and every request signed before it stops
# verifying. The account needs no balance.
SEP7_SIGNING_SECRET=

# The deployed voucher contract. Leave it empty to take the testnet default
# that the library carries.
CONTRACT_ID=

# The token contract. Leave it empty to take the network's native asset.
TOKEN_ID=

# The network. Leave these empty to take the testnet values.
NETWORK_PASSPHRASE=
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Where the listener posts one message per redemption. The receiver must
# answer only after it has stored the message, because that answer is what
# moves the listener's position. A message that a receiver accepts and loses
# is one that nothing sends again.
WEBHOOK_URL=

# Where the listener keeps its position. It sits outside a release, because a
# deployment replaces a release and would take the position with it. A
# checkout with no deployment leaves this unset and uses ./listener.json.
LISTENER_STATE_FILE=/opt/senet/state/listener.json

# The ledger that a first start reads from, when no position file exists.
# Leave it empty to start at the present. The network keeps about seven days
# of history, so a value older than that is refused.
LISTENER_START_LEDGER=
