# The Soroban RPC server and the Horizon server. Both have a default.
RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# The deployed voucher contract.
CONTRACT_ID=

# The four testnet accounts that produce the evidence set.
# A signs every voucher. B pays the network fee and selects the recipient.
# C stands for a merchant. D receives a refused attempt.
A_SECRET=
B_SECRET=
C_SECRET=
D_SECRET=

# The fee-payer channel accounts, as a comma-separated list of secret keys.
# One channel serves one transaction per ledger, so the count sets the
# throughput. The load check needs at least as many channels as it runs
# concurrent redemptions.
FEEPAYER_CHANNELS=
