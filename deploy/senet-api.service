# The Senet fee-payer service.
#
# Install it at /etc/systemd/system/senet-api.service.
#
# The service listens on the loopback interface only. The web server in front
# of it terminates TLS and proxies /api/ to it, so the service never faces the
# public network itself.

[Unit]
Description=Senet fee-payer service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/senet
ExecStart=/usr/bin/node server/dist/tools/serve.js
Restart=always
RestartSec=3
# The channel keys live in this file, which git never carries.
Environment=ENV_FILE=/opt/senet/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
